{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MBA GED – Ouverture",
  "version": "0.1.3",
  "identifier": "ch.mbagroupe.ged.ouverture",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MBA GED – Ouverture",
        "width": 560,
        "height": 380,
        "visible": false,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Ouvre les fichiers de la GED MBA Group dans l'application du poste",
    "longDescription": "Assistant d'ouverture de la GED MBA Group : appelé par un lien mbaged:// depuis le dashboard, il retrouve le fichier dans le dossier OneDrive synchronisé et l'ouvre avec l'application choisie (AutoCAD, Archicad, …). Chaque enregistrement remonte dans SharePoint.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "wix": {
        "language": "fr-FR"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mbaged"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwMzY5NUQ2MDVGODVGNEYKUldSUFgvZ0YxcFUyZ0xlcmxxYVhGSVpGZW5tb1g1TFpuNVgxMnNqajFRaldubXlIOHZPNHBMQzIK",
      "endpoints": ["https://github.com/raphaelmascolo-ai/mba-ged-ouverture/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
